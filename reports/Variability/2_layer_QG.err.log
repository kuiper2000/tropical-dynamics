        U1=2.0, U2=0.0, r1=3.0e-7, r2=1.2e-6, nu8=3.0e10,
        dt=60.0, nsteps=4000, save_every=200,
        sponge_tau=2.0*24*3600.0, sponge_width=3.0e5,
    )

    model = TwoLayerQG(p)
    t_days, psi1_hist, psi2_hist = model.integrate()

    # Quick visualization of last snapshot
    psi1 = psi1_hist[-1]
